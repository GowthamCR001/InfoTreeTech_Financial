# Firebase Client SDK Configuration (Vite environment variables)
# Copy this file to .env and replace the placeholder values with your Firebase Console credentials:
# Project Overview > Project settings > General > Your apps > Web app (Firebase SDK snippet)

VITE_FIREBASE_API_KEY=AIzaSyPlaceholder_ReplaceWithActualKey
VITE_FIREBASE_AUTH_DOMAIN=your-company-finance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-company-finance
VITE_FIREBASE_STORAGE_BUCKET=your-company-finance.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
